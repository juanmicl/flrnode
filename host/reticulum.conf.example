# FLRNode host example — copy to <config-dir>/config on each host.
# NOTE: current RNS (2025-12 images) expects the file to be named
# "config" (no extension) inside its config directory, interfaces
# nested under an [interfaces] section, and the keys below.
# Adjust port to the by-id path of the attached D1 mini
# (ls /dev/serial/by-id/). Speed must stay 921600 8N1.

[reticulum]
  enable_transport = yes
  share_instance = yes

[interfaces]
  [[Default Interface]]
    type = SerialInterface
    interface_enabled = yes
    port = /dev/serial/by-id/usb-1a86_7523_IFLNodeBridge-if00-port0
    speed = 921600
    databits = 8
    parity = none
    stopbits = 1
